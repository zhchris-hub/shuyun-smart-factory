# 启动真实设备模式前，填写三个账户密码及 devices.json。
FACTORY_ADMIN_PASSWORD=
FACTORY_OPERATOR_PASSWORD=
FACTORY_VIEWER_PASSWORD=

# 可选模型。默认在本机用同一组数据查询工具作答。
FACTORY_MODEL_ENABLED=0
FACTORY_MODEL_ID=qwen-plus
FACTORY_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FACTORY_MODEL_API_KEY=
FACTORY_ALLOW_EXTERNAL_MODEL=0

# 可选，只读工具供内网程序调用。填写随机令牌后，可用 Bearer 方式访问工具。
FACTORY_SKILL_TOKEN=
# 可选，受信的内网 Streamable HTTP MCP 服务，可在管理员的模型与工具页测试。
FACTORY_REMOTE_MCP_URL=
FACTORY_REMOTE_MCP_TOKEN=
